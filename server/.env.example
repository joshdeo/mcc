# Copy this file to .env and fill in the values. Never share or upload the real .env file.

# Who receives every form submission
MAIL_TO=joshua.deosaran@gmail.com

# The email account the server sends from (for Gmail: smtp.gmail.com, port 587, and an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=joshua.deosaran@gmail.com
SMTP_PASS=your_app_password_here

# The address the emails appear to come from. Usually the same as SMTP_USER.
MAIL_FROM=joshua.deosaran@gmail.com

# Web addresses allowed to send forms to this server, separated by commas.
# For a GitHub Pages site use https://yourname.github.io (no path, no trailing slash).
ALLOWED_ORIGINS=https://yourname.github.io

# Port to listen on (hosting services usually set this for you)
PORT=3000

# Set to 0 when this server only handles forms and the site is hosted elsewhere
SERVE_SITE=1

# Set to 1 if the server sits behind a proxy or load balancer that sets X-Forwarded-For (most hosting services do)
TRUST_PROXY=0

# Set to 1 to print emails instead of sending them, for testing only
DRY_RUN=0
