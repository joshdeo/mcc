# Copy this file to .env and fill in the values. Never share the real .env file.

# Where submissions are delivered
MAIL_TO=joshua.deosaran@gmail.com

# Your email provider's SMTP details (for Gmail: smtp.gmail.com, port 587, and an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=joshua.deosaran@gmail.com
SMTP_PASS=your_app_password_here

# The address the emails appear to come from. Usually the same as SMTP_USER.
MAIL_FROM=joshua.deosaran@gmail.com

# Port to listen on
PORT=3000

# Optional: only accept form posts from this exact site address, for example https://example.org
ALLOWED_ORIGIN=

# Set to 1 if the server sits behind a proxy or load balancer that sets X-Forwarded-For
TRUST_PROXY=0

# Set to 1 to print emails instead of sending them (also happens automatically if SMTP_HOST is empty)
DRY_RUN=0
